{
  "name": "syncroedit",
  "version": "1.0.0",
  "description": "Cloudflare Workers and Durable Objects collaborative editor.",
  "main": "src-worker/index.js",
  "scripts": {
    "start": "npm run db:migrate:local && npm run db:seed:local && wrangler dev --env local --port 8787 --live-reload",
    "dev": "npm run db:migrate:local && npm run db:seed:local && wrangler dev --env local --port 8787 --live-reload",
    "deploy": "wrangler deploy --env staging",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --env local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "node scripts/seed-dev-user.mjs",
    "test": "npm run test:unit && npm run test:integration && npm run test:frontend",
    "test:unit": "cross-env SKIP_DB_SETUP=true jest tests/unit",
    "test:integration": "cross-env SKIP_DB_SETUP=true jest tests/integration",
    "test:frontend": "cross-env SKIP_DB_SETUP=true jest tests/frontend",
    "test:e2e": "playwright test --config=config/playwright.config.js",
    "lint": "eslint . --config config/eslint.config.cjs",
    "format": "prettier --write . --config config/.prettierrc --ignore-path config/.prettierignore"
  },
  "jest": {
    "setupFilesAfterEnv": [
      "./tests/setup.js"
    ],
    "setupFiles": [
      "./tests/env.js"
    ],
    "testEnvironment": "node",
    "maxWorkers": 1,
    "moduleNameMapper": {
      "^/js/(.*)$": "<rootDir>/public/js/$1",
      "^y-websocket$": "<rootDir>/tests/mocks/emptyModule.js",
      "^y-quill$": "<rootDir>/tests/mocks/emptyModule.js",
      "^/vendor/idb-keyval/index\\.js$": "idb-keyval"
    },
    "transform": {
      "^.+\\.jsx?$": [
        "babel-jest",
        {
          "configFile": "./config/.babelrc"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/golba98/SyncroEdit.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/golba98/SyncroEdit/issues"
  },
  "homepage": "https://github.com/golba98/SyncroEdit#readme",
  "dependencies": {
    "dompurify": "3.4.14",
    "hono": "^4.13.7",
    "idb-keyval": "^6.3.0",
    "quill": "2.0.2",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@playwright/browser-chromium": "^1.61.1",
    "@playwright/test": "^1.62.1",
    "babel-jest": "^30.2.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.9.5",
    "wrangler": "^4.127.0"
  },
  "overrides": {
    "js-yaml": "4.3.1"
  }
}
